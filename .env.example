# Application Settings
APP_PORT=3000

# Security Settings
# IMPORTANT: Generate a strong, random JWT secret for production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED: Server will not start without a valid JWT secret
JWT_SECRET=GENERATE_YOUR_OWN_SECRET_USING_COMMAND_ABOVE
JWT_EXPIRES_IN=24h

# CORS Settings
# Comma-separated list of allowed origins
# Use '*' to allow all origins (NOT recommended for production)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Kimai Integration (Optional)
KIMAI_API_URL=https://demo.kimai.org
KIMAI_API_TOKEN=

# RunPod Integration (Optional)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
