# Case Management System - Environment Configuration

# ===========================================
# Kimai API Configuration
# ===========================================
KIMAI_API_URL=https://kimai-glg-u11035.vm.elestio.app
KIMAI_API_TOKEN=00d1c3f02410b298ac3bc2624

# ===========================================
# Database Configuration (Kimai Database)
# ===========================================
# Note: These will need to be updated with your actual Kimai database credentials
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kimai
DB_USER=kimai
DB_PASSWORD=your_password_here

# ===========================================
# Application Configuration
# ===========================================
APP_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0

# JWT Secret for authentication (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session settings
SESSION_TIMEOUT=3600

# ===========================================
# CORS Configuration
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ===========================================
# Redis (Optional - for caching)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Email Configuration (Optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ===========================================
# File Upload
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ===========================================
# Feature Flags
# ===========================================
ENABLE_KIMAI_SYNC=true
ENABLE_AUTO_SYNC=false
SYNC_INTERVAL_MINUTES=30
